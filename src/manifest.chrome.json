{
  "manifest_version": 3,
  "name": "Anagnosi – Document Reader",
  "version": "2.0.0",
  "description": "Open and read Word (.docx), Excel (.xlsx), PowerPoint (.pptx), and RTF files directly in your browser with themes, typography controls, and full-text search.",
  "permissions": [
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*/*docx",
    "*://*/*xlsx",
    "*://*/*pptx",
    "*://*/*rtf",
    "file://*/*docx",
    "file://*/*xlsx",
    "file://*/*pptx",
    "file://*/*rtf"
  ],
  "action": {
    "default_title": "Open Anagnosi DocX Reader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/background.ts",
    "type": "module"
  },
  "options_ui": {
    "page": "index.html",
    "open_in_tab": true
  }
}